{
  "manifest_version": 3,
  "name": "Auto Tab Grouper",
  "version": "1.3.0",
  "description": "Automatically groups tabs by domain (supports wildcards, configurable via options/popup).",
  "minimum_chrome_version": "111",
  "permissions": ["tabs", "tabGroups", "storage", "scripting", "downloads", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
